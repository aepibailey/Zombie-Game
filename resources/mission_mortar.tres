[gd_resource type="Resource" script_class="FireMissionConfig" load_steps=3 format=3]

; 120mm mortar fire mission. Every number here is a playtest knob.
;
; effect_radius (10m) is the paint circle, and it is GROUND TRUTH — the true
; outer bound of everything this mission can damage, not an approximation.
; Rounds do NOT land anywhere in this whole radius: FireMissionSystem insets
; the actual landing locus by the HE profile's own max_radius (7m — how far
; one round reaches from where it lands, see mortar_he.tres), so a round
; landing at the very edge of its scatter locus still can't blast past this
; circle. See FireMissionSystem._scatter_radius(). Both this and max_radius
; were halved together from the original 20m/14m pass — same six rounds,
; same timing, same per-round damage, landing in half the area.
;
; wp_radius 0 = pure HE, no burn zone left behind. Shake-and-bake is a
; separate config with the same pipeline and a nonzero wp_radius.

[ext_resource type="Script" path="res://scripts/FireMissionConfig.gd" id="1_cfg"]
[ext_resource type="Resource" path="res://resources/mortar_he.tres" id="2_he"]

[resource]
script = ExtResource("1_cfg")
id = "mortar"
display_name = "120mm Mortar"
cost = 50
cooldown = 180.0
time_of_flight = 8.0
round_count = 6
mission_duration = 9.0
effect_radius = 10.0
he_profile = ExtResource("2_he")
wp_radius = 0.0
wp_duration = 45.0
wp_damage_per_second = 25.0
wp_tick_interval = 0.2

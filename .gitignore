# Godot 4+ specific ignores
.godot/
/android/
/builds/
/export/

# macOS
.DS_Store

# Godot export presets can contain secrets
export_presets.cfg

# Import metadata regenerated by `godot --headless --import`. This project has
# never tracked these — .godot/ above is already ignored, so a fresh clone
# rebuilds both together and nothing depends on them being in history.
# NOTE: Godot's own docs suggest committing *.import instead, which makes a
# clone's first import deterministic. Swapping to that is one line; it was left
# alone here to match what this repo has always done rather than to settle it.
*.import
